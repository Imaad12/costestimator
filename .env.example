# Copy to .env and edit. Never commit .env. All values optional.
# KSA_DB_PATH=var/ksa_estimator.db
# KSA_DATA_DIR=data
# KSA_WORKSPACES_DIR=projects                       # numbered project workspaces (default <repo>/projects)
# KSA_SECRET_KEY=change-me-long-random-string      # signs login tokens; auto-generated into var/secret.key if unset
# KSA_ALLOW_SELF_APPROVAL=true                      # single-user MVP default; set false for small teams
# KSA_AI_ENABLED=false                              # AI is optional; deterministic features never need it
# ANTHROPIC_API_KEY=                                # only when KSA_AI_ENABLED=true
# KSA_AI_MODEL=claude-sonnet-5-5
# KSA_LOG_LEVEL=INFO
# KSA_CSRF_ORIGIN_CHECK=true                        # cookie-authenticated writes must be same-origin (docs/SECURITY.md)
# KSA_SECURITY_HEADERS=true                         # CSP, nosniff, frame denial, no-store caching
# KSA_LOGIN_MAX_FAILURES=5                          # consecutive failed sign-ins before a name is locked (0 disables)
# KSA_LOGIN_LOCK_MINUTES=15
# KSA_TLS=false                                     # set when TLS is terminated in front of the app (Secure cookies, HSTS)
